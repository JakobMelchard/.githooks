#!/usr/bin/env bash
# Exercise each hook script against good and bad inputs. Tools that are not installed are skipped
# here (the hooks themselves fail on a missing tool; that path is covered once, via gofmt).
# bash 3.2 compatible.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
h="$root/hooks"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cd "$tmp" && git init -q .

n=0 bad=0
ok() { n=$((n + 1)); if "$@" >/dev/null 2>&1; then :; else bad=$((bad + 1)); echo "FAIL (expected pass): $*"; fi; }
no() { n=$((n + 1)); if "$@" >/dev/null 2>&1; then bad=$((bad + 1)); echo "FAIL (expected fail): $*"; fi; }
msg() { printf '%s\n' "$1" >m; }
have() { command -v "$1" >/dev/null 2>&1; }
have_prettier() { [ -x node_modules/.bin/prettier ] || (have npx && npx --no-install prettier --version >/dev/null 2>&1); }
have_eslint() { [ -x node_modules/.bin/eslint ] || (have npx && npx --no-install eslint --version >/dev/null 2>&1); }

# conventional-commit
msg 'feat: add x';                  ok "$h/conventional-commit.sh" m
msg 'fix(api)!: drop v1';           ok "$h/conventional-commit.sh" m
msg 'Merge branch main';            ok "$h/conventional-commit.sh" m
msg 'fixup! feat: add x';           ok "$h/conventional-commit.sh" m
printf '# comment\n\nchore: x\n' >m; ok "$h/conventional-commit.sh" m
msg 'added stuff';                  no "$h/conventional-commit.sh" m
msg 'feature: add x';               no "$h/conventional-commit.sh" m
msg "feat: $(printf 'x%.0s' $(seq 1 100))"; no "$h/conventional-commit.sh" m

# shell-syntax
printf '#!/usr/bin/env bash\necho ok\n' >good.sh
printf '#!/bin/sh\nif then\n' >bad
ok "$h/shell-syntax.sh" good.sh
no "$h/shell-syntax.sh" bad
if have zsh; then printf '#!/usr/bin/env zsh\ncase x in\n' >bad.zsh; no "$h/shell-syntax.sh" bad.zsh; fi

# gofmt: rewrites and fails, then passes
if have gofmt; then
  printf 'package x\nfunc  F( ) {}\n' >x.go
  no "$h/gofmt.sh" x.go
  ok "$h/gofmt.sh" x.go
fi
# a missing tool fails instead of skipping: a PATH holding only what the script itself needs
mkdir nobin
for t in bash dirname; do ln -s "$(command -v "$t")" "nobin/$t"; done
printf 'package x\n' >y.go
no env PATH="$PWD/nobin" "$h/gofmt.sh" y.go
out=$(PATH="$PWD/nobin" "$h/gofmt.sh" y.go 2>&1); printf "%s" "$out" | grep -q "gofmt not found" || { bad=$((bad + 1)); echo "FAIL: missing-tool message"; }
n=$((n + 1))

# tofu-fmt
if have tofu || have terraform; then
  printf 'resource "a" "b" {\nx=1\n}\n' >m.tf
  ok "$h/tofu-fmt.sh" m.tf
  grep -q 'x = 1' m.tf || { bad=$((bad + 1)); echo "FAIL: tofu-fmt did not rewrite"; }
  n=$((n + 1))
fi

# swift-format (macOS, or Linux with a swift toolchain)
if have swift-format || xcrun --find swift-format >/dev/null 2>&1; then
  printf 'let  x=1\n' >a.swift
  ok "$h/swift-format.sh" a.swift
  grep -q 'let x = 1' a.swift || { bad=$((bad + 1)); echo "FAIL: swift-format did not rewrite"; }
  n=$((n + 1))
fi

# prettier
if have_prettier; then
  printf "const a = 'x'\n" > p.js
  ok "$h/prettier.sh" p.js
  grep -q "const a = 'x'" p.js || { bad=$((bad + 1)); echo "FAIL: prettier rewrote file without config"; }
  n=$((n + 1))
  out=$("$h/prettier.sh" p.js 2>&1)
  printf "%s" "$out" | grep -q "no config found" || { bad=$((bad + 1)); echo "FAIL: prettier missing skip notice"; }
  n=$((n + 1))

  echo '{"prettier": {"semi": false}}' > package.json
  printf "const a = 'x';\n" > p.js
  ok "$h/prettier.sh" p.js
  grep -q "const a = \"x\"" p.js || { bad=$((bad + 1)); echo "FAIL: prettier did not format with config"; }
  n=$((n + 1))
  rm -f package.json p.js
fi

# eslint
if have_eslint; then
  printf "const a = 'x'\n" > e.js
  ok "$h/eslint.sh" e.js
  out=$("$h/eslint.sh" e.js 2>&1)
  printf "%s" "$out" | grep -q "no config found" || { bad=$((bad + 1)); echo "FAIL: eslint missing skip notice"; }
  n=$((n + 1))

  cat <<'EOF' > eslint.config.js
module.exports = [{
  rules: {
    "no-var": "error"
  }
}];
EOF
  printf "var a = 1\n" > e.js
  no "$h/eslint.sh" e.js
  printf "const a = 1\n" > e.js
  ok "$h/eslint.sh" e.js
  rm -f eslint.config.js e.js
fi

echo "$((n - bad))/$n passed"
[ "$bad" -eq 0 ]
